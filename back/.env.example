# Server
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/chatbot
CLIENT_URL=http://localhost:3000
JWT_SECRET=

# Email
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# Google login
GOOGLE_CLIENT_ID=

# AI / vector search
GEMINI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=

# eSewa ePay v2 (server-side only)
# Sandbox product code is EPAYTEST. Get the current UAT secret from
# https://developer.esewa.com.np/pages/Epay
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_ENVIRONMENT=sandbox
# Optional overrides; leave blank to use the official sandbox/production URLs.
ESEWA_FORM_URL=
ESEWA_STATUS_URL=

# Khalti KPG-2 (server-side only)
# Sandbox secret key comes from https://test-admin.khalti.com
KHALTI_SECRET_KEY=
KHALTI_ENVIRONMENT=sandbox

# Exchange rate: NRB first, open.er-api.com as a marked backup.
EXCHANGE_RATE_API_URL=https://www.nrb.org.np/api/forex/v1/rates
EXCHANGE_RATE_CACHE_MINUTES=360
